{
  "name": "belies-bites",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
